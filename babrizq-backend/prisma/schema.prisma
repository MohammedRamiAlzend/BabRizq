// ------------------------------------------------------------------
// Bab Rizq — Prisma schema
//
// Relational model derived from docs/analysis.md (Phase 1 ERD).
// - SQLite is the default dev provider (zero-config).
// - To switch to Postgres/MySQL: change `provider` and the DATABASE_URL,
//   then run `prisma migrate dev`. No SQL dialect is used anywhere —
//   all queries go through the Prisma client.
//
// NOTE: SQLite has no enum support, so enums (role, status, type) are
// modeled as `String` with allowed values documented inline. The domain
// layer validates them with class-validator DTOs.
// ------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Identity & access
// ------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  // Unique Google account id when the user signed up via Google (OAuth).
  googleId     String?  @unique
  nameEn       String
  nameAr       String
  phone        String?
  // role ∈ customer | store_owner | back_office | delivery | marketer | admin
  role         String
  // status ∈ active | suspended
  status       String   @default("active")
  // delivery-only availability flag (driver roster / live map)
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens      RefreshToken[]
  stores             Store[]
  orders             Order[]
  assignedOrders     Order[] @relation("AssignedDriver")
  driverProfile      DriverProfile?
  cart               Cart?
  affiliateLinks     AffiliateLink[]
  withdrawalRequests WithdrawalRequest[]
  marketerSettings   MarketerSettings?
  customerInterests  CustomerInterest[]
  notifications      Notification[]
  chatConversations  ChatConversation[]

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256 of the raw refresh token (never store raw)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ------------------------------------------------------------------
// Platform-level configuration
// ------------------------------------------------------------------

model PlatformSetting {
  id              Int      @id @default(1) // singleton row
  platformName    String
  supportEmail    String
  defaultCurrency String
  commissionRate  Float    @default(5.5) // %
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model PlatformCategory {
  code   String @id // e.g. "Electronics", "Accessories"
  nameAr String
  sortOrder Int @default(0)

  stores           Store[]
  products         Product[]
  customerInterests CustomerInterest[]
  ads              Ad[]
}

// ------------------------------------------------------------------
// Stores (store-owner domain)
// ------------------------------------------------------------------

model Store {
  id            String  @id @default(cuid())
  ownerUserId   String
  nameEn        String
  nameAr        String
  emoji         String  @default("🛍️")
  descriptionEn String?
  descriptionAr String?
  categoryCode  String
  // status ∈ active | suspended | pending
  status        String  @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner       User            @relation(fields: [ownerUserId], references: [id])
  category    PlatformCategory @relation(fields: [categoryCode], references: [code])
  settings    StoreSettings?
  categories  StoreCategory[]
  products    Product[]
  orders      Order[]
  suppliers   Supplier[]
  purchaseOrders PurchaseOrder[]
  stockTakes  StockTake[]
  inventoryBatches InventoryBatch[]
  invoices    Invoice[]
  expenses    Expense[]
  offers      Offer[]
  ads         Ad[]
  affiliateLinks AffiliateLink[]
  fiscalYears FiscalYear[]
  ledgerAccounts LedgerAccount[]
  journalEntries JournalEntry[]

  @@index([ownerUserId])
  @@index([categoryCode])
}

model StoreSettings {
  id                     String @id @default(cuid())
  storeId                String @unique
  logoUrl                String?
  coverUrl               String?
  contactEmail           String?
  phone                  String?
  addressEn              String?
  addressAr              String?
  taxRate                Float  @default(0)
  acceptedCurrenciesJson String @default("[\"SAR\"]")
  paymentMethodsJson     String @default("[]")
  notifyNewOrder         Boolean @default(true)
  notifyLowStock         Boolean @default(true)
  lowStockThreshold      Int    @default(10)
  deliveryFee            Float  @default(0)
  freeShippingThreshold  Float  @default(0)
  estimatedDeliveryDays  Int    @default(2)
  updatedAt              DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model StoreCategory {
  id      String @id @default(cuid())
  storeId String
  nameEn  String
  nameAr  String
  emoji   String @default("📁")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeId])
}

// ------------------------------------------------------------------
// Catalog (customer + store-owner domains)
// ------------------------------------------------------------------

model Product {
  id               String   @id @default(cuid())
  storeId          String
  storeCategoryId  String?
  categoryCode     String
  nameEn           String
  nameAr           String
  descriptionEn    String?
  descriptionAr    String?
  imageUrl         String?
  price            Float
  originalPrice    Float?
  stock            Int      @default(0)
  // Current unit cost (FIFO-weighted) — feeds stock valuation and, once the
  // warehouse module consumes FIFO layers at checkout, real COGS in the ledger.
  cost             Float?
  // Per-product low-stock override; falls back to StoreSettings.lowStockThreshold.
  lowStockThreshold Int?
  // Set when a low-stock alert fires; cleared when restocked above threshold.
  // Prevents duplicate notifications while the product stays low.
  lowStockAlertedAt DateTime?
  sku              String?
  rating           Float    @default(0)
  reviewCount      Int      @default(0)
  isNew            Boolean  @default(false)
  isFeatured       Boolean  @default(false)
  // status ∈ active | archived | out_of_stock
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store       Store            @relation(fields: [storeId], references: [id])
  storeCategory StoreCategory? @relation(fields: [storeCategoryId], references: [id], onDelete: SetNull)
  category    PlatformCategory @relation(fields: [categoryCode], references: [code])
  tags        ProductTag[]
  stockMovements StockMovement[]
  inventoryBatches InventoryBatch[]
  purchaseOrderItems PurchaseOrderItem[]
  stockTakeItems StockTakeItem[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  offers      Offer[]
  affiliateLinks AffiliateLink[]

  @@index([storeId])
  @@index([categoryCode])
  @@index([storeCategoryId])
  @@index([status])
}

model ProductTag {
  id        String @id @default(cuid())
  productId String
  value     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, value])
  @@index([value])
}

model Supplier {
  id          String @id @default(cuid())
  storeId     String
  nameEn      String
  nameAr      String
  contactName String?
  phone       String?
  email       String?
  address     String?
  // Expected days from order to delivery — shown on the supplier card and
  // used to set purchase-order expected dates.
  leadTimeDays Int?
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  @@index([storeId])
  @@index([isActive])
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  storeId     String
  poNumber    String
  supplierId  String
  // status ∈ draft | ordered | partial | received | cancelled
  status      String   @default("draft")
  expectedAt  DateTime?
  orderedAt   DateTime?
  receivedAt  DateTime?
  notes       String?
  // Ordered amount snapshot (Σ quantity × unitCost) at creation time.
  totalAmount Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store   Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier           @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@unique([storeId, poNumber])
  @@index([storeId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String @id @default(cuid())
  purchaseOrderId  String
  productId        String
  quantity         Int // ordered quantity
  receivedQuantity Int    @default(0)
  unitCost         Float // ordered cost per unit (SAR)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model StockTake {
  id          String   @id @default(cuid())
  storeId     String
  // status ∈ open | completed | cancelled
  status      String   @default("open")
  notes       String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items StockTakeItem[]

  @@index([storeId])
  @@index([status])
}

model StockTakeItem {
  id              String @id @default(cuid())
  stockTakeId     String
  productId       String
  countedQuantity Int // physical count entered by the store
  systemQuantity  Int // system stock snapshot when the count was taken
  variance        Int // counted - system (positive = found extra units)

  stockTake StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([stockTakeId])
}

/** FIFO cost layer — one row per received lot of units. */
model InventoryBatch {
  id         String   @id @default(cuid())
  storeId    String
  productId  String
  // Remaining units in this layer; consumed oldest-first at checkout.
  quantity   Int
  unitCost   Float
  receivedAt DateTime @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([productId, receivedAt])
}

model StockMovement {
  id         String   @id @default(cuid())
  productId  String
  supplierId String?
  // type ∈ in | out | adjustment
  type       String
  quantity   Int
  reason     String?
  reasonAr   String?
  // Cost per unit at the time of the movement — purchase cost for receipts,
  // current unit cost for adjustments. Feeds stock valuation history.
  unitCost   Float?
  // Groups the movements produced by one business event (a PO receipt or a
  // stocktake completion) so the ledger entry can be traced to its source.
  referenceId String?
  movementDate DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([movementDate])
  @@index([referenceId])
}

// ------------------------------------------------------------------
// Commerce (customer domain)
// ------------------------------------------------------------------

model Cart {
  id           String   @id @default(cuid())
  customerUserId String @unique
  updatedAt    DateTime @updatedAt

  customer User       @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  cartId    String
  productId String
  quantity  Int @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([cartId, productId])
}

model Order {
  id                String    @id @default(cuid())
  customerUserId    String?
  storeId           String
  assignedDriverId  String? // User.id where role = delivery
  orderNumber       String    @unique
  orderDate         DateTime  @default(now())
  // status flow: pending → processing → assigned → picked_up → in_transit → delivered
  status            String    @default("pending")
  customerNameEn    String
  customerNameAr    String
  customerPhone     String
  addressEn         String
  addressAr         String
  lat               Float?
  lng               Float?
  paymentMethod     String?
  notes             String?
  subtotal          Float
  // Applied offer discount (SAR). Kept on the order for the ledger and for
  // offer analytics; tax is computed on (subtotal - discount).
  discount          Float     @default(0)
  deliveryFee       Float     @default(0)
  tax               Float     @default(0)
  total             Float
  currency          String    @default("SAR")
  // The offer that was applied at checkout (null when none applied).
  offerId           String?
  proofOfDeliveryUrl String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer      User?       @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  store         Store       @relation(fields: [storeId], references: [id])
  driver        User?       @relation("AssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  offer         Offer?      @relation(fields: [offerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  invoice       Invoice?
  notifications Notification[]

  @@index([storeId])
  @@index([offerId])
  @@index([customerUserId])
  @@index([assignedDriverId])
  @@index([status])
  @@index([orderDate])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String?
  nameEn    String // snapshot — product names may change later
  nameAr    String
  qty       Int
  price     Float // snapshot at purchase time

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ------------------------------------------------------------------
// Promotions & advertising
// ------------------------------------------------------------------

model Offer {
  id            String  @id @default(cuid())
  storeId       String
  productId     String?
  titleEn       String
  titleAr       String
  // discountType ∈ percent | fixed
  discountType  String
  discountValue Float
  validFrom     DateTime?
  validTo       DateTime?
  // status ∈ active | expired | paused
  status        String  @default("active")
  // Incremented at checkout whenever this offer is applied to an order.
  redemptionCount Int   @default(0)
  createdAt     DateTime @default(now())

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  orders  Order[]

  @@index([storeId])
  @@index([status])
}

model Ad {
  id          String  @id @default(cuid())
  // placement ∈ home | store | category
  placement   String
  storeId     String?
  categoryCode String?
  titleEn     String
  titleAr     String
  subtitleEn  String?
  subtitleAr  String?
  ctaEn       String?
  ctaAr       String?
  emoji       String  @default("✨")
  gradient    String  @default("from-amber-400 to-orange-500")
  linkType    String? // category | store
  linkValue   String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  store    Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  category PlatformCategory? @relation(fields: [categoryCode], references: [code], onDelete: SetNull)

  @@index([placement, active])
}

// ------------------------------------------------------------------
// Store-owner accounting & warehouse
// ------------------------------------------------------------------

model Invoice {
  id            String  @id @default(cuid())
  storeId       String
  orderId       String  @unique
  invoiceNumber String  @unique
  subtotal      Float
  discount      Float   @default(0)
  tax           Float   @default(0)
  total         Float
  currency      String  @default("SAR")
  issueDate     DateTime @default(now())
  // status ∈ draft | issued | paid
  status        String  @default("issued")
  // ZATCA Phase-1: base64 PNG of the tax-invoice QR (seller, VAT number,
  // timestamp, total). Full Phase-2 XML + signature is generated by the
  // ZatcaInvoiceProvider in the accounting module (P3 of the plan).
  qrCode        String?
  vatNumber     String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model FiscalYear {
  id        String   @id @default(cuid())
  storeId   String
  label     String // e.g. "2026"
  startDate DateTime
  endDate   DateTime
  // status ∈ open | closing | closed
  status    String   @default("open")
  openedAt  DateTime @default(now())
  closedAt  DateTime?

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([storeId, label])
  @@index([storeId])
}

model LedgerAccount {
  id             String  @id @default(cuid())
  storeId        String
  code           String // KSA-standard code, e.g. 1100 Cash
  nameEn         String
  nameAr         String
  // type ∈ asset | liability | equity | revenue | expense
  type           String
  isSystem       Boolean @default(false) // seeded template accounts — not deletable
  parentId       String?
  openingBalance Float   @default(0)

  store          Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent         LedgerAccount?     @relation("LedgerAccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       LedgerAccount[]    @relation("LedgerAccountTree")
  journalLines   JournalEntryLine[]

  @@unique([storeId, code])
  @@index([storeId])
}

model JournalEntry {
  id           String   @id @default(cuid())
  storeId      String
  fiscalYearId String?
  entryNumber  String // sequential per store (e.g. JE-2026-0001)
  // sourceType ∈ order | expense | payout | opening | adjustment | closing
  sourceType   String
  sourceId     String? // orderId, expenseId, ...
  memoEn       String?
  memoAr       String?
  entryDate    DateTime @default(now())
  // Link to the reversal entry, if any. One entry can be reversed at most
  // once (reversals themselves are never reversed).
  reversedById String?  @unique
  postedAt     DateTime @default(now())

  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fiscalYear  FiscalYear?         @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  lines       JournalEntryLine[]
  reversedBy  JournalEntry?       @relation("JournalReversal", fields: [reversedById], references: [id])
  reverses    JournalEntry?       @relation("JournalReversal")
  @@index([storeId, entryDate])
  @@index([storeId, sourceType, sourceId])
}

model JournalEntryLine {
  id            String  @id @default(cuid())
  entryId       String
  accountId     String
  debit         Float   @default(0)
  credit        Float   @default(0)
  descriptionEn String?
  descriptionAr String?

  entry   JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

model Expense {
  id          String  @id @default(cuid())
  storeId     String
  titleEn     String
  titleAr     String
  category    String
  amount      Float
  currency    String  @default("SAR")
  expenseDate DateTime @default(now())
  note        String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([expenseDate])
}

// ------------------------------------------------------------------
// Marketer (affiliate) domain
// ------------------------------------------------------------------

model AffiliateLink {
  id            String @id @default(cuid())
  marketerUserId String
  storeId       String?
  productId     String?
  url           String
  targetNameEn  String
  targetNameAr  String
  // type ∈ store | product
  type          String
  clicks        Int    @default(0)
  conversions   Int    @default(0)
  earned        Float  @default(0)
  createdAt     DateTime @default(now())

  marketer User    @relation(fields: [marketerUserId], references: [id], onDelete: Cascade)
  store    Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([marketerUserId])
}

model WithdrawalRequest {
  id              String   @id @default(cuid())
  marketerUserId  String
  amount          Float
  bankIban        String?
  walletId        String?
  // status ∈ pending | approved | paid | rejected
  status          String   @default("pending")
  estimatedDays   Int      @default(2)
  createdAt       DateTime @default(now())

  marketer User @relation(fields: [marketerUserId], references: [id], onDelete: Cascade)

  @@index([marketerUserId])
  @@index([status])
}

model MarketerSettings {
  id                   String @id @default(cuid())
  userId               String @unique
  payoutMethod         String @default("bank") // bank | wallet
  bankIban             String?
  walletId             String?
  notifyNewConversion  Boolean @default(true)
  notifyPayoutProcessed Boolean @default(true)
  notifyPromotions     Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------
// Personalization
// ------------------------------------------------------------------

model CustomerInterest {
  id             String   @id @default(cuid())
  customerUserId String
  categoryCode   String
  lastSeenAt     DateTime @default(now())
  sortOrder      Int      @default(0)

  customer User             @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  category PlatformCategory @relation(fields: [categoryCode], references: [code])

  @@unique([customerUserId, categoryCode])
}

// ------------------------------------------------------------------
// Delivery domain
// ------------------------------------------------------------------

model DriverProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  phone          String?
  available      Boolean @default(true)
  activeOrderId  String? // User.id of the order currently assigned

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------
// Communication (chat + notifications)
// ------------------------------------------------------------------

model ChatConversation {
  id               String   @id @default(cuid())
  backOfficeUserId String
  // type ∈ customer | store
  type             String
  partnerType      String // customer | store
  partnerId        String  // User.id or Store.id (polymorphic partner)
  lastMessageEn    String?
  lastMessageAr    String?
  lastTimestamp    DateTime @default(now())
  unreadCount      Int      @default(0)

  backOfficeUser User             @relation(fields: [backOfficeUserId], references: [id])
  messages       ChatMessage[]

  @@index([backOfficeUserId])
  @@index([partnerType, partnerId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderType     String // customer | store | back_office
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  timestamp      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Notification {
  id             String   @id @default(cuid())
  recipientUserId String
  // type ∈ new_order | order_status | driver_update | delivery_confirmed | customer_message | payout | low_stock
  type           String
  titleEn        String
  titleAr        String
  bodyEn         String
  bodyAr         String
  isRead         Boolean  @default(false)
  orderId        String?
  timestamp      DateTime @default(now())

  recipient User  @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  order     Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, isRead])
  @@index([timestamp])
}
