# ------------------------------------------------------------------
# Bab Rizq backend — environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api
API_VERSION=v1

# CORS (comma-separated origins of the six role apps)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://localhost:8085,http://localhost:8086

# Database (SQLite for development; switch provider for Postgres/MySQL — see prisma/schema.prisma)
DATABASE_URL=file:./dev.db

# JWT (access + refresh)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP — Nodemailer; used in the integrations phase)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bab Rizq <no-reply@babrizq.com>

# Payments (integrations phase)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYMENTS_PROVIDER=stripe

# Maps (integrations phase)
GOOGLE_MAPS_API_KEY=
MAPS_PROVIDER=google

# Redis (cache + queues — integrations phase)
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage — switch drivers with STORAGE_DRIVER: local | azure | s3
# `local` works with zero config: files land in STORAGE_PATH (served at /uploads/*)
STORAGE_DRIVER=local
STORAGE_PATH=./uploads

# Azure Blob (used when STORAGE_DRIVER=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=babrizq

# AWS S3 (used when STORAGE_DRIVER=s3)
AWS_S3_BUCKET=
AWS_S3_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google login (OAuth) — SPA id-token flow + redirect flow
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Where the browser lands after the redirect flow, with ?accessToken=&refreshToken=
FRONTEND_REDIRECT_URL=http://localhost:5173/auth/google/callback

# Rate limiting (per-IP throttling for the public API)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
